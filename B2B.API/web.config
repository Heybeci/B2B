<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- WebDAVModule (etkin olan IIS sunucularında) DELETE/PUT gibi
           "authoring" fiillerini AspNetCoreModuleV2'ye hiç ulaştırmadan
           kendi yakalıyor -> istemciye 405 (Allow: GET, HEAD, OPTIONS,
           TRACE) dönüyor, uygulama kodu hiç devreye girmiyor. Bu kaldırma
           WebDAV kurulu olmayan ortamlarda (örn. yerel dev) zararsız/no-op. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- IIS'in kendi request-filtering modülü, Kestrel/[RequestSizeLimit]'ten
           bağımsız ve önce devreye giren ~28.6 MB (30,000,000 byte)
           varsayılan bir üst sınır uyguluyor -> büyük resim/video yüklemeleri
           uygulamaya hiç ulaşmadan ham (JSON olmayan) 404.13 ile reddediliyordu.
           Program.cs'teki Kestrel limiti ve controller'daki
           [RequestSizeLimit(2_100_000_000)] ile aynı değere çekildi. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="2100000000" />
        </requestFiltering>
      </security>
      <!-- ASPNETCORE_ENVIRONMENT=Development burada KASITLI (bkz. plan.md
           bölüm 1.1) — bu dosya dev.b2b'deki yerel test sitesi için, hep
           Development kalması gerekiyor. SGAPPSRV'deki gerçek prod dağıtımı
           bu dosyayı DEĞİL, `dotnet publish B2B.API -c Release` çıktısındaki
           kendi web.config'ini kullanır — orada ASPNETCORE_ENVIRONMENT'ın
           Production olarak ayarlanması gerekir (SGAPPSRV'deki IIS
           Application'ın kendi ortam ayarı/Publish profili üzerinden,
           kullanıcı tarafından). Bu satırı buradan kopyalamayın. -->
      <aspNetCore processPath="bin\Debug\net10.0\B2B.API.exe" arguments="" stdoutLogEnabled="false" hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>